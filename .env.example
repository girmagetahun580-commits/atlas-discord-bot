# === REQUIRED ===
# Discord bot token (from discord.com/developers/applications → Bot → Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Gemini API key (from aistudio.google.com → API Keys)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key (from elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs voice ID (browse voices at elevenlabs.io/voice-library)
# Recommended: "Daniel" for warm male, "Rachel" for warm female
ELEVENLABS_VOICE_ID=your_chosen_voice_id_here

# Deepgram API key (from deepgram.com → Dashboard → API Keys)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# === OPTIONAL ===
# Gemini model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Voice channel name to auto-join (default: Atlas Voice)
VOICE_CHANNEL_NAME=Atlas Voice

# Text channel name to listen in (default: atlas)
TEXT_CHANNEL_NAME=atlas
